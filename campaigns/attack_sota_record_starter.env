# Starter preset to iterate from the current public SOTA script.
# Run this on a local clone of openai/parameter-golf after downloading the dataset/tokenizer.
#
# First cheap iteration: 1xH100 exploratory run using the public record script.
# For an official record attempt, move to 8xH100 SXM and collect 3+ seeds with logs.

TRAIN_SCRIPT=records/track_10min_16mb/2026-03-19_SlidingWindow_FP16Emb_10L_MuonWD_OvertoneInit/train_gpt.py
COMMAND=torchrun --standalone --nproc_per_node=1 records/track_10min_16mb/2026-03-19_SlidingWindow_FP16Emb_10L_MuonWD_OvertoneInit/train_gpt.py
DATA_PATH=./data/datasets/fineweb10B_sp1024/
TOKENIZER_PATH=./data/tokenizers/fineweb_1024_bpe.model
VOCAB_SIZE=1024
RUN_ID=attack_sota_record_starter
SEED=1337
VAL_LOSS_EVERY=200
TRAIN_LOG_EVERY=100
MAX_WALLCLOCK_SECONDS=600
